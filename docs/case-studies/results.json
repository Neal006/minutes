    "meeting": {
      "id": "f4dacba8-1da1-4976-9ffc-ef799e0cfb1d",
      "title": "Postmortem for Tuesday's Outage",
      "title_locked": false,
      "status": "ready",
      "created_at": 1790233158243,
      "duration_ms": 77160,
      "summary": "The postmortem for Tuesday's outage identified an expired API key for the speech provider as the root cause, affecting 300 meetings for 47 minutes. Actions were assigned to add provider error alerts, migrate API keys to a secret manager, notify affected customers, and scope a circuit breaker for retries.",
      "decisions": [
        "Retries need a circuit breaker so a dead provider does not flood the queue."
      ],
      "error": null,
      "audio_mime": null,
      "has_audio": false,
      "segments": [
        {
          "id": 35,
          "start_ms": 0,
          "end_ms": 3840,
          "text": "This is the postmortem for Tuesday's outage."
        },
        {
          "id": 36,
          "start_ms": 3840,
          "end_ms": 11500,
          "text": "Transcription was down for 47 minutes, from 210 to 257 in the afternoon."
        },
        {
          "id": 37,
          "start_ms": 11500,
          "end_ms": 16240,
          "text": "The root cause was an expired API key for our speech provider."
        },
        {
          "id": 38,
          "start_ms": 16240,
          "end_ms": 20640,
          "text": "Requests started failing and our retries made the queue back up."
        },
        {
          "id": 39,
          "start_ms": 20000,
          "end_ms": 27000,
          "text": "We had no alert on the error rate from the provider, so we only found out when customers wrote in."
        },
        {
          "id": 40,
          "start_ms": 27000,
          "end_ms": 30000,
          "text": "How many customers were affected?"
        },
        {
          "id": 41,
          "start_ms": 30000,
          "end_ms": 34000,
          "text": "About 300 meetings had no transcript."
        },
        {
          "id": 42,
          "start_ms": 34000,
          "end_ms": 40000,
          "text": "We reprocessed all of them by 5 o'clock, so no data was lost."
        },
        {
          "id": 43,
          "start_ms": 40000,
          "end_ms": 46000,
          "text": "I will add an alert that fires when provider errors go above 5% for two minutes."
        },
        {
          "id": 44,
          "start_ms": 46000,
          "end_ms": 48000,
          "text": "I can ship that by Friday."
        },
        {
          "id": 45,
          "start_ms": 48000,
          "end_ms": 56000,
          "text": "I will move the API keys into the secret manager with expiry reminders, by the end of next week."
        },
        {
          "id": 46,
          "start_ms": 56000,
          "end_ms": 61000,
          "text": "And I will write the customer update and post it on the status page."
        },
        {
          "id": 47,
          "start_ms": 60000,
          "end_ms": 62000,
          "text": "page today."
        },
        {
          "id": 48,
          "start_ms": 62000,
          "end_ms": 68240,
          "text": "We agreed that retries need a circuit breaker, so a dead provider does not flood the queue."
        },
        {
          "id": 49,
          "start_ms": 68240,
          "end_ms": 71500,
          "text": "Jordan, can you scope that?"
        },
        {
          "id": 50,
          "start_ms": 71500,
          "end_ms": 76000,
          "text": "Yes, I will write a short design doc for the circuit breaker next week."
        }
      ],
      "action_items": [
        {
          "id": 10,
          "meeting_id": "f4dacba8-1da1-4976-9ffc-ef799e0cfb1d",
          "text": "Add an alert that fires when provider errors go above 5% for two minutes.",
          "owner": null,
          "due": "Friday",
          "done": 0,
          "start_ms": 40000
        },
        {
          "id": 11,
          "meeting_id": "f4dacba8-1da1-4976-9ffc-ef799e0cfb1d",
          "text": "Move the API keys into the secret manager with expiry reminders.",
          "owner": null,
          "due": "end of next week",
          "done": 0,
          "start_ms": 48000
        },
        {
          "id": 12,
          "meeting_id": "f4dacba8-1da1-4976-9ffc-ef799e0cfb1d",
          "text": "Write the customer update and post it on the status page.",
          "owner": null,
          "due": "today",
          "done": 0,
          "start_ms": 56000
        },
        {
          "id": 13,
          "meeting_id": "f4dacba8-1da1-4976-9ffc-ef799e0cfb1d",
          "text": "Write a short design doc for the circuit breaker.",
          "owner": "Jordan",
          "due": "next week",
          "done": 0,
          "start_ms": 71000
        }
      ],
