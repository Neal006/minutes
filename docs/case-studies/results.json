    "meeting": {
      "id": "32cb01ed-e0c3-4485-80e8-f4e567c8a599",
      "title": "Meeting notes with Dana",
      "title_locked": false,
      "status": "ready",
      "created_at": 1790233130094,
      "duration_ms": 67795,
      "summary": "Dana's support team handles about 40 customer calls per day and needs bug details and action items captured automatically in Zendesk. EU data residency is a hard requirement; the vendor does not have a European region yet but is exploring one.",
      "decisions": [
        "Zendesk must automatically capture bug details and action items.",
        "All data must remain in the European Union.",
        "Dana wants a pilot with 10 agents next month if data residency works."
      ],
      "error": null,
      "audio_mime": null,
      "has_audio": false,
      "segments": [
        {
          "id": 18,
          "start_ms": 0,
          "end_ms": 5600,
          "text": "Thanks for joining, Dana. What made you start looking for a meeting notes tool?"
        },
        {
          "id": 19,
          "start_ms": 5600,
          "end_ms": 12320,
          "text": "Our support team runs about 40 customer calls a day, and nobody has time to write notes."
        },
        {
          "id": 20,
          "start_ms": 12320,
          "end_ms": 15600,
          "text": "Important details get lost."
        },
        {
          "id": 21,
          "start_ms": 15600,
          "end_ms": 19120,
          "text": "What happens today when a customer reports a bug on a call?"
        },
        {
          "id": 22,
          "start_ms": 19120,
          "end_ms": 20120,
          "text": "The agent types."
        },
        {
          "id": 23,
          "start_ms": 20000,
          "end_ms": 26440,
          "text": "a quick summary into Zendisk, but half the time the steps to reproduce are missing."
        },
        {
          "id": 24,
          "start_ms": 26440,
          "end_ms": 31360,
          "text": "So the key requirement is getting bug details and action items into Zendisk automatically."
        },
        {
          "id": 25,
          "start_ms": 31360,
          "end_ms": 33040,
          "text": "Exactly."
        },
        {
          "id": 26,
          "start_ms": 33040,
          "end_ms": 37000,
          "text": "And all of our data must stay in the European Union."
        },
        {
          "id": 27,
          "start_ms": 37000,
          "end_ms": 39360,
          "text": "That is a hard requirement from our legal team."
        },
        {
          "id": 28,
          "start_ms": 40000,
          "end_ms": 45000,
          "text": "Understood. We do not have a European region yet, but it is on our roadmap."
        },
        {
          "id": 29,
          "start_ms": 45000,
          "end_ms": 49000,
          "text": "I will confirm the date with our engineers and email you by Friday."
        },
        {
          "id": 30,
          "start_ms": 49000,
          "end_ms": 57000,
          "text": "Please do. If data residency works out, we would want a pilot with 10 agents next month."
        },
        {
          "id": 31,
          "start_ms": 57000,
          "end_ms": 61000,
          "text": "Great. I will also send over our security questions."
        },
        {
          "id": 32,
          "start_ms": 60000,
          "end_ms": 61000,
          "text": "questionnaire today."
        },
        {
          "id": 33,
          "start_ms": 61000,
          "end_ms": 62000,
          "text": "Perfect."
        },
        {
          "id": 34,
          "start_ms": 62000,
          "end_ms": 66560,
          "text": "I will bring Marco from our legal team to the next call."
        }
      ],
      "action_items": [
        {
          "id": 7,
          "meeting_id": "32cb01ed-e0c3-4485-80e8-f4e567c8a599",
          "text": "Confirm the European region date with engineers and email Dana.",
          "owner": null,
          "due": "Friday",
          "done": 0,
          "start_ms": null
        },
        {
          "id": 8,
