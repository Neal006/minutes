    "id": "incident-postmortem",
    "title": "Incident postmortem",
    "durationSec": 77.16,
    "chunkCount": 4,
    "skippedSilentChunks": 0,
    "wer": 0.06951871657754011,
    "totalMs": 27363.3419,
