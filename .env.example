# ── Notes + Ask ────────────────────────────────────────────────────────────
# Default: OpenRouter free models. Free key (no card): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# AI_PROVIDER=openrouter            # openrouter | anthropic | mock (offline demo)
# Fallback chain, tried in order. See what's free today: npm run models:free
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,openrouter/free

# Or Claude: set AI_PROVIDER=anthropic and ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# ── Transcription ──────────────────────────────────────────────────────────
# Default (no key needed): local Whisper on this machine via transformers.js. $0, private;
# downloads ~80 MB once on first use.
# STT_PROVIDER=local
# LOCAL_STT_MODEL=onnx-community/whisper-base.en   # or onnx-community/whisper-small for more accuracy
# MODEL_CACHE_DIR=./data/models

# Whisper API (Groq's free tier: 8 h of audio/day, very fast):
# STT_PROVIDER=whisper
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=
# (OpenAI: STT_BASE_URL defaults to https://api.openai.com/v1 with whisper-1 and OPENAI_API_KEY)

# OpenRouter audio models: note OpenRouter requires ≥ $0.50 account balance for audio, even on :free models
# STT_PROVIDER=openrouter
# OPENROUTER_STT_MODELS=thinkingmachines/inkling-small:free,thinkingmachines/inkling:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ── Automations ────────────────────────────────────────────────────────────
# POST notes here when a meeting is ready (comma-separated; Slack incoming webhooks work as-is)
# WEBHOOK_URLS=https://hooks.slack.com/services/...

# PORT=3001
# DATA_DIR=./data
