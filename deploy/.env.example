# ── AI (all free tiers) ─────────────────────────────────────────────────────
# Notes + Ask: OpenRouter free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
# Transcription: Groq's free Whisper tier (8 h of audio/day, real timestamps). https://console.groq.com/keys
STT_PROVIDER=whisper
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=
# Or keep transcription on OpenRouter too (50 req/day free ≈ 16 min of audio): STT_PROVIDER=openrouter

# Automations (optional): Slack incoming webhook(s), comma-separated
WEBHOOK_URLS=

# ── Cloudflare ─────────────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → create → copy the token. Public hostname → http://app:3001
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backups: Cloudflare R2 (10 GB free) ────────────────────────────────────
R2_BUCKET=minutes-backup
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
