# Becomes the minutes-env secret (deploy/bootstrap.sh). Copy to app.env; app.env is git-ignored.
# ── AI (all free tiers) ─────────────────────────────────────────────────────
# Notes + Ask: OpenRouter free models (paid ids are refused at startup). https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
# Transcription: Groq's free Whisper tier (8 h of audio/day). https://console.groq.com/keys
STT_PROVIDER=whisper
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=
# Or transcribe on the VM itself, no Groq account (slower on 2 ARM cores): STT_PROVIDER=local

# Automations (optional): Slack incoming webhook(s), comma-separated
WEBHOOK_URLS=
