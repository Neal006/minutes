# Becomes the minutes-backup secret, read only by the Litestream containers. Copy to backup.env.
# Oracle Object Storage (Always Free: 20 GB) through its S3-compatible API:
#   bucket:      Storage → Buckets → create "minutes-backup" (private)
#   keys:        Profile → Customer secret keys → generate
#   namespace:   Tenancy details → Object storage namespace
LITESTREAM_BUCKET=minutes-backup
LITESTREAM_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
LITESTREAM_REGION=<region, e.g. eu-frankfurt-1>
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
